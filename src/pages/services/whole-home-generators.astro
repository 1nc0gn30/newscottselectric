---
import Layout from '../../layouts/Layout.astro';
import InteractiveQuoteCalculator from '../../components/InteractiveQuoteCalculator.jsx';
import AEOFAQ from '../../components/AEOFAQ.astro';
---

<Layout 
  title="Whole Home Standby Generator Installation Hampton Roads 757"
  description="Automatic standby generator installations in Virginia Beach, Norfolk, Chesapeake & 757 area. Never lose power during hurricanes or severe coastal storms."
  serviceName="Whole Home Generators"
>
  <section class="py-16 bg-gradient-to-b from-brand-card to-brand-dark border-b border-brand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <div>
          <span class="text-xs font-bold text-brand-gold bg-brand-gold/10 px-3 py-1 rounded-full border border-brand-gold/20 uppercase tracking-widest">
            🔋 Automatic Emergency Backup Power
          </span>
          <h1 class="font-heading text-4xl sm:text-5xl font-extrabold text-white mt-4 leading-tight">
            Whole-Home Standby <br />
            <span class="gold-gradient-text">Generator Installation</span>
          </h1>
          <p class="mt-4 text-base text-gray-300 leading-relaxed">
            Protect your family against severe coastal storms, blackouts, and power grid failures. Automatic transfer switches restore power within seconds to keep HVAC, lights, and appliances running safely.
          </p>
          <div class="mt-8">
            <a href="tel:7575360478" class="bg-brand-gold hover:bg-brand-goldHover text-black font-extrabold px-6 py-3 rounded-xl text-xs shadow-gold-glow">
              Request Generator Consultation →
            </a>
          </div>
        </div>
        <div class="relative rounded-3xl overflow-hidden shadow-card border border-gray-800">
          <img src="/assets/images/generator_install.png" alt="Whole Home Standby Generator Installation" class="w-full h-auto object-cover" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-brand-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <InteractiveQuoteCalculator client:visible />
    </div>
  </section>

  <AEOFAQ title="Standby Generator FAQ" />
</Layout>
