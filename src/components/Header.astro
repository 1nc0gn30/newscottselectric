---
const cities = [
  { name: 'Virginia Beach', slug: '/virginia-beach-electrician' },
  { name: 'Norfolk', slug: '/norfolk-electrician' },
  { name: 'Chesapeake', slug: '/chesapeake-electrician' },
  { name: 'Newport News', slug: '/newport-news-electrician' },
  { name: 'Hampton', slug: '/hampton-electrician' },
  { name: 'Portsmouth', slug: '/portsmouth-electrician' },
  { name: 'Suffolk', slug: '/suffolk-electrician' }
];

const services = [
  { name: 'Electrical Panel Upgrades', slug: '/services/electrical-panel-upgrades' },
  { name: 'EV Charger Installation', slug: '/services/ev-charger-installation' },
  { name: 'Whole Home Generators', slug: '/services/whole-home-generators' },
  { name: 'Custom & Recessed Lighting', slug: '/services/custom-lighting-installation' },
  { name: 'Smart Home Automation', slug: '/services/smart-home-automation' },
  { name: 'Commercial Electrical', slug: '/services/commercial-electrical' }
];
---

<header class="fixed top-0 left-0 right-0 z-40 glass-nav transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group" aria-label="Scott's Electric Home Page">
        <img 
          src="/assets/images/scotts_electric_logo_transparent.png" 
          alt="Scott's Electric Hampton Roads Logo" 
          class="h-16 md:h-20 w-auto bg-transparent border-none p-0 m-0 group-hover:scale-105 transition-transform"
        />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-7 text-sm font-semibold text-gray-200" aria-label="Main Navigation">
        <a href="/" class="hover:text-brand-amber transition-colors">Home</a>

        <!-- Services Dropdown -->
        <div class="relative group py-4">
          <button class="flex items-center gap-1.5 hover:text-brand-amber transition-colors focus:outline-none" aria-expanded="false" aria-haspopup="true">
            <span>Services</span>
            <svg class="w-4 h-4 text-brand-amber group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="absolute top-full left-0 w-64 glass-panel rounded-xl py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 shadow-2xl border border-gray-800">
            {services.map(service => (
              <a href={service.slug} class="block px-4 py-2.5 text-xs text-gray-300 hover:bg-brand-cardHover hover:text-brand-amber transition-colors">
                {service.name}
              </a>
            ))}
            <div class="border-t border-gray-800 my-1"></div>
            <a href="/services" class="block px-4 py-2 text-xs font-bold text-brand-cyan hover:text-white transition-colors">
              View All 18+ Services →
            </a>
          </div>
        </div>

        <!-- 7 Cities Dropdown -->
        <div class="relative group py-4">
          <button class="flex items-center gap-1.5 hover:text-brand-amber transition-colors focus:outline-none" aria-expanded="false" aria-haspopup="true">
            <span class="text-brand-gold">757 Service Cities</span>
            <svg class="w-4 h-4 text-brand-amber group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="absolute top-full left-0 w-56 glass-panel rounded-xl py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 shadow-2xl border border-gray-800">
            {cities.map(city => (
              <a href={city.slug} class="block px-4 py-2 text-xs text-gray-300 hover:bg-brand-cardHover hover:text-brand-amber transition-colors">
                ⚡ Electrician in {city.name}
              </a>
            ))}
          </div>
        </div>

        <a href="/faqs" class="hover:text-brand-amber transition-colors text-brand-cyan">FAQs & AI Answers</a>
        <a href="/about" class="hover:text-brand-amber transition-colors">About Us</a>
        <a href="/contact" class="hover:text-brand-amber transition-colors">Contact</a>
      </nav>

      <!-- Right Call CTA Button & Theme Toggle -->
      <div class="hidden sm:flex items-center gap-3">
        <!-- Sun/Moon Theme Toggle Button -->
        <button 
          id="theme-toggle-btn"
          type="button" 
          aria-label="Toggle Light and Dark Mode"
          class="p-2.5 rounded-full border border-brand-gold/30 bg-brand-card hover:bg-brand-cardHover text-brand-gold transition-all focus:outline-none shadow-gold-glow"
        >
          <svg id="theme-sun-icon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
          <svg id="theme-moon-icon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
          </svg>
        </button>

        <a 
          href="tel:7575360478" 
          class="flex items-center gap-2 border border-brand-gold/40 hover:border-brand-gold bg-brand-card/80 hover:bg-brand-cardHover text-brand-amber px-4 py-2 rounded-full text-xs font-bold transition-all shadow-gold-glow"
        >
          <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <span>(757) 536-0478</span>
        </a>
      </div>

      <!-- Mobile Hamburger Menu Button -->
      <div class="lg:hidden flex items-center gap-2">
        <button 
          id="theme-toggle-btn-mobile"
          type="button" 
          aria-label="Toggle Light and Dark Mode"
          class="p-2 rounded-full border border-brand-gold/30 bg-brand-card text-brand-gold"
        >
          🌙
        </button>
        <button 
          id="mobile-menu-btn" 
          class="p-2 text-gray-300 hover:text-brand-gold focus:outline-none" 
          aria-label="Toggle Navigation Menu"
        >
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden bg-brand-dark/95 border-b border-brand-border px-4 pt-2 pb-6 space-y-3">
    <a href="/" class="block px-3 py-2 rounded-md text-base font-semibold text-gray-200 hover:bg-brand-card hover:text-brand-amber">Home</a>
    
    <div class="px-3 py-1 font-bold text-xs uppercase tracking-wider text-brand-gold">757 Service Cities</div>
    <div class="grid grid-cols-2 gap-1 px-3">
      {cities.map(city => (
        <a href={city.slug} class="text-xs text-gray-300 hover:text-brand-amber py-1.5">
          {city.name}
        </a>
      ))}
    </div>

    <div class="px-3 py-1 font-bold text-xs uppercase tracking-wider text-brand-cyan">Popular Services</div>
    <div class="space-y-1 px-3">
      {services.map(service => (
        <a href={service.slug} class="block text-xs text-gray-300 hover:text-brand-amber py-1">
          {service.name}
        </a>
      ))}
    </div>

    <div class="pt-2 border-t border-gray-800">
      <a href="tel:7575360478" class="block text-center bg-brand-gold text-black font-extrabold py-3 rounded-xl">
        📞 Call (757) 536-0478 Now
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }

  // Light / Dark Mode Toggle Logic
  const toggleBtn = document.getElementById('theme-toggle-btn');
  const toggleBtnMobile = document.getElementById('theme-toggle-btn-mobile');
  const sunIcon = document.getElementById('theme-sun-icon');
  const moonIcon = document.getElementById('theme-moon-icon');

  const updateIcons = (theme) => {
    if (theme === 'light') {
      sunIcon?.classList.add('hidden');
      moonIcon?.classList.remove('hidden');
    } else {
      moonIcon?.classList.add('hidden');
      sunIcon?.classList.remove('hidden');
    }
  };

  const getInitialTheme = () => {
    const saved = localStorage.getItem('theme');
    if (saved) return saved;
    return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
  };

  let currentTheme = getInitialTheme();
  document.documentElement.className = currentTheme;
  updateIcons(currentTheme);

  const toggleTheme = () => {
    currentTheme = currentTheme === 'dark' ? 'light' : 'dark';
    document.documentElement.className = currentTheme;
    localStorage.setItem('theme', currentTheme);
    updateIcons(currentTheme);
  };

  toggleBtn?.addEventListener('click', toggleTheme);
  toggleBtnMobile?.addEventListener('click', toggleTheme);
</script>
